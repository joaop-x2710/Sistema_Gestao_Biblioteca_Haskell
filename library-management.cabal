cabal-version:      2.4
name:               library-management
version:            0.1.0.0
build-type:         Simple

executable library-manager
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Model, Domain, SampleData
  build-depends:    base >=4.14 && <5
  default-language: Haskell2010
  ghc-options:      -Wall

test-suite library-manager-tests
  type:             exitcode-stdio-1.0
  main-is:          TestMain.hs
  hs-source-dirs:   test, src
  other-modules:    Model, Domain, SampleData
  build-depends:    base >=4.14 && <5
  default-language: Haskell2010
  ghc-options:      -Wall
